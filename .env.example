# Origin folder
FOLDER_ORIG=/tmp/origin
# Destination folder
FOLDER_DEST=/tmp/destination
# Folder for images whose date cannot be read from EXIF or the filename
FOLDER_ERROR=/tmp/errors
# Ordered, comma-separated datetime formats used to find dates in filenames
DATE_PATTERNS=%Y%m%d%H%M,%Y%m%d,%y%m%d
